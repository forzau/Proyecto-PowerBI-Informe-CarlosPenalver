{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.156.json",
  "name": "F1 Performance Analytics",
  "dataColors": [
    "#E10600",
    "#3B82F6",
    "#F2C94C",
    "#2FB344",
    "#9B51E0",
    "#F2994A",
    "#2D9CDB",
    "#EB5757",
    "#56CCF2",
    "#BB6BD9"
  ],
  "good": "#2FB344",
  "neutral": "#A7ABB4",
  "bad": "#E03131",
  "maximum": "#2FB344",
  "center": "#F59F00",
  "minimum": "#E03131",
  "null": "#A7ABB4",
  "foreground": "#F5F5F5",
  "firstLevelElements": "#F5F5F5",
  "secondLevelElements": "#A7ABB4",
  "thirdLevelElements": "#343A46",
  "fourthLevelElements": "#A7ABB4",
  "background": "#0F1115",
  "secondaryBackground": "#242831",
  "tableAccent": "#E10600",
  "textClasses": {
    "callout": {
      "fontSize": 30,
      "fontFace": "Segoe UI Semibold",
      "color": "#F5F5F5"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#F5F5F5"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#F5F5F5"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#A7ABB4"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1A1D23"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#343A46"
              }
            },
            "radius": 4,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 13,
            "fontColor": {
              "solid": {
                "color": "#F5F5F5"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#343A46"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#343A46"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "stylePreset": [
          {
            "name": "None"
          }
        ],
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit",
            "backColor": {
              "solid": {
                "color": "#242831"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#F5F5F5"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#1A1D23"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#242831"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#F5F5F5"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#F5F5F5"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "stylePreset": [
          {
            "name": "None"
          }
        ],
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit",
            "backColor": {
              "solid": {
                "color": "#242831"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#F5F5F5"
              }
            },
            "bold": true
          }
        ],
        "rowHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#1A1D23"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#F5F5F5"
              }
            }
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#1A1D23"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#242831"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#F5F5F5"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#F5F5F5"
              }
            }
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "bold": true,
            "$id": "default"
          }
        ],
        "label": [
          {
            "show": true,
            "$id": "default"
          }
        ],
        "cardCalloutArea": [
          {
            "paddingUniform": 0
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#A7ABB4"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A7ABB4"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#343A46"
              }
            }
          }
        ],
        "dataPoint": [
          {
            "borderShow": false
          }
        ],
        "legend": [
          {
            "show": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A7ABB4"
              }
            }
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#A7ABB4"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A7ABB4"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#343A46"
              }
            }
          }
        ],
        "dataPoint": [
          {
            "borderShow": false
          }
        ],
        "legend": [
          {
            "show": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A7ABB4"
              }
            }
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#A7ABB4"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A7ABB4"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#343A46"
              }
            }
          }
        ],
        "dataPoint": [
          {
            "borderShow": false
          }
        ],
        "legend": [
          {
            "show": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A7ABB4"
              }
            }
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#A7ABB4"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A7ABB4"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#343A46"
              }
            }
          }
        ],
        "dataPoint": [
          {
            "borderShow": false
          }
        ],
        "legend": [
          {
            "show": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A7ABB4"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2.5,
            "lineChartType": "linear"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#A7ABB4"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A7ABB4"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#343A46"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A7ABB4"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontFamily": "Segoe UI Semibold",
            "textSize": 10,
            "fontColor": {
              "solid": {
                "color": "#F5F5F5"
              }
            },
            "background": {
              "solid": {
                "color": "#1A1D23"
              }
            },
            "outlineStyle": 0
          }
        ],
        "items": [
          {
            "fontFamily": "Segoe UI",
            "textSize": 9,
            "fontColor": {
              "solid": {
                "color": "#F5F5F5"
              }
            },
            "background": {
              "solid": {
                "color": "#1A1D23"
              }
            },
            "outlineStyle": 0,
            "padding": 2
          }
        ],
        "date": [
          {
            "fontFamily": "Segoe UI",
            "textSize": 9,
            "fontColor": {
              "solid": {
                "color": "#F5F5F5"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    }
  }
}
